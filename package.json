{
  "name": "macro-extension",
  "version": "0.4.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:prod": "vite build --mode production-terser",
    "build:firefox": "vite build --config vite.firefox.config.ts",
    "build:firefox:prod": "vite build --config vite.firefox.config.ts --mode production",
    "preview": "vite preview",
    "test": "vitest run",
    "test:verbose": "vitest run --reporter=verbose",
    "lint": "eslint src --ext .js,.jsx,.ts,.tsx",
    "lint:css": "stylelint \"src/**/*.css\"",
    "audit:styles": "npm run build && node scripts/style-coverage-audit.mjs",
    "lint:css:fix": "stylelint \"src/**/*.css\" --fix",
    "format": "prettier --write .",
    "serve": "node scripts/live-reload-server.js",
    "dev:full": "concurrently --kill-others-on-fail --names 'VITE,RELOAD' --prefix-colors 'blue,green' 'npm run dev' 'npm run serve'",
    "dev:stop": "./scripts/stop-dev.sh",
    "dev:restart": "npm run dev:stop && npm run dev:full",
    "dev:status": "lsof -i:5173,3001 || echo 'No development servers running'",
    "size": "node scripts/check-build-size.js",
    "lint:fix": "eslint . --fix",
    "test:styles": "node scripts/style-smoke.mjs",
    "ermine:css": "node scripts/update-ermine-css.mjs"
  },
  "dependencies": {
    "@preact/preset-vite": "^2.10.5",
    "dompurify": "^3.2.7",
    "fuzzysort": "^3.1.0",
    "preact": "^10.29.1",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.0.0",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/preact": "^3.2.4",
    "@testing-library/user-event": "^14.6.1",
    "@types/chrome": "^0.1.4",
    "@types/dompurify": "^3.0.5",
    "@vitest/coverage-v8": "3.2.4",
    "autoprefixer": "^10.4.21",
    "chokidar": "^3.6.0",
    "concurrently": "^8.2.2",
    "eslint": "^9.38.0",
    "eslint-plugin-react": "^7.33.2",
    "express": "^4.21.2",
    "jsdom": "^26.1.0",
    "playwright": "^1.61.0",
    "postcss": "^8.5.6",
    "postcss-preset-env": "^10.1.3",
    "prettier": "^3.2.5",
    "stylelint": "^16.25.0",
    "stylelint-config-standard": "^39.0.1",
    "terser": "^5.44.0",
    "typescript": "^5.5.4",
    "vite": "^7.1.3",
    "vite-plugin-devtools-json": "^1.0.0",
    "vitest": "^3.2.4",
    "ws": "^8.18.3"
  }
}
